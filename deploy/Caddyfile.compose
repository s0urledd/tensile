{$DOMAIN} {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# The dashboard is a static export that talks only to its own API.
		# 'unsafe-inline' is required by the export itself: Next.js emits two
		# inline <script> blocks (hydration data) and inline style attributes,
		# and a static site cannot carry per-response nonces. Serving the API
		# on a different origin means widening connect-src to match.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Next.js content-hashed assets never change under the same name.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# The API sets its own Cache-Control (errors are no-store); do not override.
	# The API under /api/v1; /api itself is the static page that documents it.
	handle /api/v1/* {
		uri strip_prefix /api
		reverse_proxy api:8080
	}
	redir /developers* /api/ 301

	handle {
		root * /var/www/fibre-observer
		try_files {path} {path}/ {path}.html
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
