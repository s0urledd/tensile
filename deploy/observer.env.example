# /etc/fibre-observer/<network>.env — one file per network the host observes
# (mocha.env, mainnet.env); the systemd units are templates and take the
# network as their instance name: fibre-scan@mocha, fibre-api@mainnet.
# One line per setting, no quotes needed. It holds the alert token, the
# webhook and the backup remote: install it 0640 root:fibre-observer
# (deploy/README.md, 3), never world-readable.
NETWORK=mocha
# your own full node with storage.discard_abci_responses = false (public RPCs
# discard block_results). Under docker compose this must be an address the
# containers can reach, not 127.0.0.1.
RPC=http://127.0.0.1:26657
VANTAGE=eu1
# one directory per network; the units can write nowhere else
DATA_DIR=/var/lib/fibre-observer/mocha
# left over from the earlier sampling: fibre-probe@ no longer passes it,
# and docker compose passes it as -policy. Keep it empty on every network:
# a policy and its master key make the prober reveal a secret for every
# past day, draws or not, into the record for good (deploy/README.md, 3).
POLICY=
# a different port per network; Caddy routes each site to its own (mocha 8081,
# mainnet 8080, as in deploy/Caddyfile and the table in deploy/README.md)
API_LISTEN=127.0.0.1:8081
# SITE_LISTEN, for fibre-site@<network> (deploy/site-server.cjs), is not set
# here: that unit reads /etc/fibre-observer/site-<network>.env, which holds
# SITE_LISTEN and API_LISTEN only (deploy/README.md, 5).

# Where this vantage watches from. Every reachability verdict on the site is a
# statement about a network path and half that path is yours. The API does
# not publish these (/v1/meta names vantages only); they feed the startup
# warning, "vantage not fully described", which a public vantage that leaves
# them blank logs (deploy/README.md, 1a).
#
# Both are your claim and nothing proves them. The observer's own addresses
# and network are not published.
VANTAGE_LOCATION=Helsinki, Finland
VANTAGE_PROVIDER=Hetzner
# scanner: height to start from on a fresh data dir (0 = chain tip at first
# start). The node must hold the 1000 blocks (the promise window) below it:
# a lower START_HEIGHT is refused at start, and a start from the tip on a
# node state-synced moments ago waits until it holds them. Pass
# deploy/test/rpc-check.sh first (it asks for 6000 blocks).
START_HEIGHT=0
# scanner: heights not to read, published as scan gaps (e.g. 1234,2000-2005).
# Leave empty. Only for a scanner that exits on the same block at every
# restart, and only as the runbook says (deploy/README.md, Runbook).
SKIP_HEIGHTS=
# prober: publications settled before this RFC 3339 time were read on the
# earlier schedule and are not read again. Empty on a new network.
END_READ_SINCE=
# prober: extra flags (fibre-probe@.service), for example -max-read-mbps 600
# or -link-mbps 900 (deploy/README.md, "The reading-rate ceiling"). Empty
# keeps the defaults. A change takes a restart of fibre-probe@<network>.
PROBE_ARGS=

# Hosting lookup (provider / country of each Fibre host; deploy/README.md 7b).
# Leave both empty: the collector then uses DATA_DIR/hosting/*.gz when
# deploy/hosting-db.sh has put them there, and is off otherwise.
HOSTING_ASN_DB=
HOSTING_COUNTRY_DB=

# Alerting: fibre-healthwatch@<network>.timer asks /v1/health every five
# minutes and posts when it is not 200: to ALERT_WEBHOOK (Discord/Slack-style
# JSON webhook) and to a Telegram chat through a bot (the token from
# @BotFather; the chat id of a chat the bot is in), whichever are set. Both
# empty = log only. Prove delivery with: fibre-healthwatch <network> --test
ALERT_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_REPEAT_MIN=60

# Backups: fibre-backup@<network>.timer copies the JSONL record nightly to
# this rclone remote (see /etc/fibre-observer/rclone.conf). Empty = off.
BACKUP_REMOTE=
# docker compose only
DOMAIN=observer.example.org
