[Unit]
Description=Fibre observer (%i): chain scanner (sentinel-scan)
After=network-online.target
Wants=network-online.target

[Service]
User=fibre-observer
EnvironmentFile=/etc/fibre-observer/%i.env
# SKIP_HEIGHTS is optional and normally unset: heights the scanner must not
# read, recorded and published as scan gaps (deploy/README.md, Runbook, "The
# scanner crash-loops on one block"). Passed as one word, -skip-heights=VALUE:
# an unset or empty SKIP_HEIGHTS becomes -skip-heights= , which the scanner
# reads as no skips, and the value can never be confused with the flag
# after it.
ExecStart=/usr/local/bin/sentinel-scan -rpc ${RPC} -data-dir ${DATA_DIR} -start-height ${START_HEIGHT} -skip-heights=${SKIP_HEIGHTS} -follow -poll 1s
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# only this instance's data directory, not the service user's whole home
ReadWritePaths=/var/lib/fibre-observer/%i

[Install]
WantedBy=multi-user.target
# one instance per network: systemctl enable --now fibre-scan@mocha
